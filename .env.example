# --- Telegram bot ---
BOT_TOKEN=
ADMINS_ID=[]

# --- Starknet RPC ---
# Primary full-node RPC endpoint. This is the network the Telegram bot talks
# to, and the one the Mini App shows by default.
# Public options: https://starknet-mainnet.g.alchemy.com/v2/<KEY>
STARKNET_RPC_URL=http://127.0.0.1:9545/rpc/v0_9
# Target network for STARKNET_RPC_URL: mainnet | sepolia
STARKNET_NETWORK=mainnet

# Optional SECOND endpoint — a Sepolia node. Setting it makes the Mini App
# show a Mainnet / Testnet switch and starts watching Sepolia validators for
# missed attestations and low operator balances. Leave it blank and nothing
# changes: no switch, no extra RPC traffic, bot untouched.
#
# The bot menu stays mainnet-only either way — testnet lives in the Mini App.
# Reward-threshold notifications also stay mainnet-only: testnet STRK has no
# price, so a "you earned $5" DM about it would be noise.
#
# Must differ from STARKNET_RPC_URL; pointing both at the same node would
# serve mainnet data under a testnet label, so we ignore it in that case.
# Public options that answered as of 2026-09:
#   https://api.cartridge.gg/x/starknet/sepolia
#   https://starknet-sepolia-rpc.publicnode.com
#   https://starknet-sepolia.drpc.org
STARKNET_TESTNET_RPC_URL=

# --- REST API (FastAPI) ---
# Host/port for the API that serves the bot + Mini App + local dashboard.
API_HOST=127.0.0.1
# Host port for the dashboard / Mini App. 8765 is the default because 8000
# often clashes with other local stacks. Change freely.
API_PORT=8765
# Auth mode for API: telegram (HMAC initData), local (no auth, loopback only), both
API_AUTH_MODE=telegram
# Public HTTPS URL where the Mini App is served. Set to enable the
# "🖥 Dashboard" button in the bot's main menu. Telegram requires HTTPS;
# during local dev expose ${API_PORT} via ngrok / cloudflared and paste
# the resulting URL here. Leave blank to hide the button.
WEBAPP_URL=

# --- Production proxy (Caddy) ---
# Hostname Caddy issues a Let's Encrypt cert for. Must resolve via DNS to
# this server's public IP BEFORE you start the stack — otherwise the ACME
# challenge fails. In dev leave blank (Caddy responds with a placeholder).
DOMAIN=

# --- Feature flags ---
# Enable attestation monitoring (requires V2 contract, default on).
ATTESTATION_MONITOR_ENABLED=true
# Cache TTL for token metadata (seconds).
TOKEN_CACHE_TTL=3600

# Кто может обращаться к API из браузера. Пусто — берём https://web.telegram.org
# и https://$DOMAIN. Несколько источников через запятую.
CORS_ORIGINS=
